# Application
APP_NAME="AI Powered Inventory Management and Intelligence Copilot"
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL 9.2 running locally on port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=inventory_copilot_db

# Storage
STORAGE_DIR=storage

# AI Copilot (Optional: Google Gemini API Key for LLM-grounded answers)
GEMINI_API_KEY=

# CORS (Frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
